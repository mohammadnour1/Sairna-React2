# Base URL used by the axios client.
# Development goes through the Vite proxy (see vite.config.js), so a relative path is enough.
# For a production build hosted on another origin, use the full URL:
#   VITE_API_BASE_URL=https://sairna.abdulrahman-hares.com/api/v1/website
VITE_API_BASE_URL=/api/v1/website

# Where the dev proxy forwards `/api/*` requests.
VITE_API_PROXY_TARGET=https://sairna.abdulrahman-hares.com

# Admin dashboard API (dev: through the Vite proxy; prod: full URL)
VITE_ADMIN_API_BASE_URL=/api/v1/dashboard
